// ============================================================
//  Modallar: Model seçici, Fayl seçici (MediaStore), Fazat/Toast
// ============================================================

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { ModelItem, PickedFile } from "state.slint";
import { ListView, Spinner } from "std-widgets.slint";
import {
    IconX, IconCheck, IconImage, IconFileDoc, IconVideoFile, IconPaperclip, IconExternalLink,
} from "icons.slint";

// ---------- Model seçici popup ----------

component ModelRow inherits Rectangle {
    in property <ModelItem> model;
    in property <bool> selected;
    callback picked();

    height: 46px;
    background: ta.has-hover ? Theme.hover : transparent;
    border-radius: 10px;

    ta := TouchArea {
        clicked => { if (root.model.enabled) { root.picked(); } }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.model.name + (root.model.enabled ? "" : "  (sign in)");
                font-size: 15px;
                font-weight: root.selected ? 700 : 400;
                color: root.model.enabled ? Theme.text : Theme.text-3;
                font-family: Theme.font-body;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.selected : IconCheck {
            width: 18px; height: 18px; y: 14px;
            stroke: Theme.text; stroke-width: 2.2px;
        }
    }
}

export component ModelPopup inherits Rectangle {
    background: #66000000;

    TouchArea {
        clicked => { App.model-popup-open = false; }
    }

    Rectangle {
        x: (parent.width - Math.min(parent.width - 24px, 400px)) / 2;
        y: parent.height - self.height - 110px;
        width: Math.min(parent.width - 24px, 400px);
        height: mp-col.preferred-height + 16px;

        background: Theme.surface;
        border-radius: 14px;
        drop-shadow-blur: 28px;
        drop-shadow-color: #55000000;

        mp-col := VerticalLayout {
            padding: 16px;
            spacing: 4px;

            HorizontalLayout {
                padding-bottom: 6px;
                Text {
                    text: "Model";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-2;
                    font-family: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                TouchArea {
                    width: 28px; height: 28px;
                    clicked => { App.model-popup-open = false; }
                    IconX { x: 6px; y: 6px; width: 16px; height: 16px; stroke: Theme.text-2; stroke-width: 2px; }
                }
            }

            for m[i] in App.models : ModelRow {
                model: m;
                selected: i == App.model-index;
                picked() => { App.select-model(i); }
            }

            // Effort
            Rectangle { height: 6px; }
            Text {
                text: "Effort";
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-2;
                font-family: Theme.font-body;
            }
            HorizontalLayout {
                spacing: 6px;
                for e[i] in 3 : Rectangle {
                    visible: (i == 0 ? App.effort-0 : i == 1 ? App.effort-1 : App.effort-2) != "";
                    height: 32px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: App.effort == i ? Theme.btn-dark : Theme.border;
                    background: App.effort == i ? Theme.btn-dark : Theme.surface;
                    eta := TouchArea {
                        clicked => { App.set-effort(i); }
                        Text {
                            text: i == 0 ? App.effort-0 : i == 1 ? App.effort-1 : App.effort-2;
                            font-size: 13px;
                            color: App.effort == i ? Theme.btn-text : Theme.text;
                            font-family: Theme.font-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// ---------- Fayl seçici (MediaStore-dan native siyahı) ----------

component PickerRow inherits Rectangle {
    in property <PickedFile> file;
    callback picked(string);

    height: 54px;
    background: ta.has-hover ? Theme.hover : transparent;
    border-radius: 10px;

    ta := TouchArea {
        clicked => { root.picked(root.file.uri); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 38px; height: 38px; y: 8px;
            border-radius: 8px;
            background: Theme.surface-2;
            if file.media == "image" : IconImage { x: 9px; y: 9px; width: 20px; height: 20px; stroke: Theme.text-2; stroke-width: 1.6px; }
            if file.media == "video" : IconVideoFile { x: 9px; y: 9px; width: 20px; height: 20px; stroke: Theme.text-2; stroke-width: 1.6px; }
            if file.media == "doc" : IconFileDoc { x: 9px; y: 9px; width: 20px; height: 20px; stroke: Theme.text-2; stroke-width: 1.6px; }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.file.name;
                font-size: 14px;
                color: Theme.text;
                font-family: Theme.font-body;
                overflow: elide;
                wrap: no-wrap;
            }
            Text {
                text: root.file.size;
                font-size: 11px;
                color: Theme.text-3;
                font-family: Theme.font-body;
            }
        }
    }
}

export component FilePickerModal inherits Rectangle {
    background: #80000000;

    TouchArea {
        clicked => { App.picker-open = false; }
    }

    Rectangle {
        x: 12px;
        y: Math.max(40px, (parent.height - self.height) / 2);
        width: parent.width - 24px;
        height: Math.min(parent.height - 80px, 560px);

        background: Theme.bg;
        border-radius: 16px;
        drop-shadow-blur: 32px;
        drop-shadow-color: #55000000;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            // başlıq
            HorizontalLayout {
                spacing: 8px;
                IconPaperclip { width: 18px; height: 18px; stroke: Theme.text; stroke-width: 1.8px; y: 6px; }
                Text {
                    text: "Attach files";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    font-family: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                TouchArea {
                    width: 32px; height: 32px;
                    clicked => { App.picker-open = false; }
                    IconX { x: 8px; y: 8px; width: 16px; height: 16px; stroke: Theme.text-2; stroke-width: 2px; }
                }
            }

            // siyahı
            if App.picker-files.length > 0 : ListView {
                vertical-stretch: 1;
                for f in App.picker-files : PickerRow {
                    file: f;
                    picked(uri) => { App.pick-file(uri); }
                }
            }

            if App.picker-files.length == 0 && !App.picker-loading : VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 10px;
                Text {
                    text: App.is-guest ? "Sign in to attach files" : "No files found";
                    font-size: 14px;
                    color: Theme.text-2;
                    font-family: Theme.font-body;
                    horizontal-alignment: center;
                }
                if !App.is-guest : Text {
                    text: "Allow storage access, then reopen the picker";
                    font-size: 12px;
                    color: Theme.text-3;
                    font-family: Theme.font-body;
                    horizontal-alignment: center;
                }
            }

            if App.picker-loading : VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                Spinner { indeterminate: true; }
            }
        }
    }
}

// ---------- Fazat/toast göstəricisi ----------

export component PhaseToast inherits Rectangle {
    if App.toast != "" : Rectangle {
        y: parent.height - 110px;
        x: (parent.width - Math.min(parent.width - 40px, toast-text.preferred-width + 40px)) / 2;
        width: Math.min(parent.width - 40px, toast-text.preferred-width + 40px);
        height: 38px;
        border-radius: 19px;
        background: Theme.dark ? #e62b2b2b : #e60d0d0d;

        toast-text := Text {
            x: 20px; y: 0;
            height: parent.height;
            text: App.toast;
            color: #ffffff;
            font-size: 13px;
            font-family: Theme.font-body;
            vertical-alignment: center;
        }
    }
}
