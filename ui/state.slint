// ============================================================
//  Qlobal state + məlumat strukturları (dairəvi importları qırmaq
//  üçün ayrı fayl — bütün ekranlar bunu import edir)
// ============================================================

// ---------- Məlumat strukturları ----------

export struct MessageBlock {
    kind: int,       // 0=mətn 1=kod 2=siyahı-elementi 3=başlıq 4=sitat
    text: string,
    lang: string,    // kod blokunun dili
}

export struct Attachment {
    id: string,       // server fayl id (upload sonrası)
    name: string,     // göstərilən ad
    media: string,    // "image" | "video" | "doc"
    status: int,      // 0=yüklənir 1=hazır 2=xəta
    size: string,     // "1.2 MB"
}

export struct ChatMessage {
    id: string,
    role: string,    // "user" | "assistant"
    text: string,    // düz mətn (balon + fallback)
    blocks: [MessageBlock],
    files: [Attachment],  // user mesajına bağlı fayllar
    streaming: bool,
    error: bool,
    retrying: bool,  // avtomatik yenidən göndərilir
    stamp: string,   // "14:32"
    parsed: bool,    // markdown blokları hazırdır (lazy parse keşi üçün)
}

export struct ConvItem {
    id: string,
    title: string,
    stamp: string,   // "2h ago"
    active: bool,
}

export struct ModelItem {
    id: string,
    name: string,
    enabled: bool,
}

export struct PickedFile {
    id: int,          // MediaStore _ID
    name: string,
    media: string,   // image|video|doc
    size: string,
    uri: string,
}

// ---------- Qlobal state ----------

export global App {
    // ---- ekran vəziyyəti ----
    // true başlayır: açılış splash-i dərhal göstərilir və sessiya tətbiq
    // olunana qədər login ekranının «flaş» etməsinin qarşısını alır
    // (əvvəl default false idi → qayıdan istifadəçi login ekranını görüb
    // sonra chat-ə düşürdü)
    in-out property <bool> booting: true;
    in-out property <bool> sidebar-open;
    in-out property <bool> streaming;
    in-out property <string> phase;            // "Thinking…" / "" (axın fazası)
    in-out property <string> toast;            // qısa bildiriş
    in-out property <string> banner;           // davamlı xəta lentı (chat üstündə)
    in-out property <bool> auto-scroll: true;
    in-out property <int> dot-tick;            // «düşünür» nöqtə animasiyası
    in-out property <bool> need-refresh;

    // ---- giriş (login) vəziyyəti ----
    in-out property <bool> authed: false;      // login ekranı keçildi (qonaq da olsa)
    in-out property <bool> signed-in;          // real hesabla
    in-out property <bool> is-guest: true;
    in-out property <string> user-name: "Guest";
    in-out property <int> login-step: 0;       // 0=welcome(Google/Email/Github) 1=email-form 2=captcha-fallback 3=token
    in-out property <bool> login-busy;
    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> token-input;
    in-out property <string> login-error;
    in-out property <bool> password-visible;
    in-out property <bool> token-auto-detected; // clipboard-da eyJ… tapıldı

    // ---- aktiv söhbət ----
    in-out property <string> chat-id;
    in-out property <string> chat-title: "New Chat";
    in-out property <[ChatMessage]> messages;

    // ---- tarixçə ----
    in-out property <[ConvItem]> conversations;
    in-out property <bool> history-loading;

    // ---- composer + əlavələr ----
    in-out property <string> input-text;
    in-out property <[Attachment]> attachments;
    in-out property <bool> picker-open;
    in-out property <[PickedFile]> picker-files;
    in-out property <bool> picker-loading;
    in-out property <bool> model-popup-open;

    // ---- modellər ----
    in-out property <[ModelItem]> models;
    in-out property <int> model-index;
    in-out property <int> effort: 2;
    in-out property <string> effort-0: "Low";
    in-out property <string> effort-1: "Medium";
    in-out property <string> effort-2: "High";
    out property <string> model-name: models.length > 0 && model-index >= 0 && model-index < models.length ? models[model-index].name : "GLM";

    // ---------- Callbacks (Rust tərəfindən qoşulur) ----------
    callback send(string);
    callback stop-generation();
    callback regenerate();
    callback new-chat();
    callback open-conversation(string);
    callback delete-conversation(string);
    callback refresh-conversations();
    callback do-sign-in(string, string);       // email, şifrə
    callback do-token-sign-in(string);         // token
    callback continue-as-guest();
    callback sign-out();
    callback open-browser(string);             // URL → sistem brauzeri (JNI)
    callback check-clipboard-token();          // clipboard-da JWT axtar
    callback open-picker();                    // MediaStore fayl seçici
    callback pick-file(string);                // seçilmiş faylın URI-si
    callback close-picker();
    callback remove-attachment(int);           // indeks
    callback retry-send();                     // son user mesajını yenidən göndər
    callback select-model(int);
    callback set-effort(int);
    callback copy-to-clipboard(string);
    callback ensure-blocks-parsed(int);            // sətir görünəndə markdown parse (lazy)

    // ---------- Yardımçı funksiyalar ----------
    public function show-toast(msg: string) {
        toast = msg;
    }
    public function current-model() -> string {
        if (models.length > 0 && model-index >= 0 && model-index < models.length) {
            return models[model-index].id;
        }
        return "glm-5.3";
    }
}
