// Veb ikonlarının (lucide tipli) Path versiyaları — PNG yoxdur, istənilən
// miqyasda kəskin, tint rəngi istənilən vaxt dəyişilir.

import { Theme } from "theme.slint";

// ---- Kiçik komponent: icon düyməsi (40x40 hit sahəsi, veb kimi) ----
export component IconButton inherits Rectangle {
    in property <length> icon-size: 20px;
    in property <color> tint: Theme.text;
    in property <bool> hoverable: true;
    callback clicked();
    width: 40px; height: 40px;
    border-radius: 8px;
    background: ta.has-hover && hoverable ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    @children
}

// ================= İKONLAR (24x24 viewBox, stroke) =================
// Hər ikon stroke-linecap/join = round ilə standartlaşdırılıb.

export component IconMenu inherits Path {
    stroke-line-cap: round;
    stroke-line-join: round;
    viewbox-width: 24; viewbox-height: 24;
    commands: "M 4 6 L 20 6 M 4 12 L 20 12 M 4 18 L 20 18";
}

