// ---- Sosial giriş ikonları (24x24) ----

// Google "G" (rəngli, vebsaytdakı kimi)
export component IconGoogle inherits Rectangle {
    width: 18px; height: 18px;
    border-radius: 9px;
    background: transparent;
    Image {
        source: @image-url("../assets/icons/google.png");
        width: 18px; height: 18px;
    }
}

// GitHub (vebsaytdakı kimi — GitHub mark)
export component IconGithub inherits Rectangle {
    width: 18px; height: 18px;
    background: transparent;
    Image {
        source: @image-url("../assets/icons/github.png");
        width: 18px; height: 18px;
        colorize: Theme.text;
    }
}

