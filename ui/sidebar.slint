// ============================================================
//  Tarixçə drawer-ı (soldan açılır)
// ============================================================

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { ConvItem } from "state.slint";
import { ListView } from "std-widgets.slint";
import { IconSquarePen, IconX, IconTrash, IconUser, IconPlus } from "icons.slint";

component ConvRow inherits Rectangle {
    in property <ConvItem> conv;
    callback open-it();
    callback delete-it();

    height: 54px;
    background: ta.has-hover ? Theme.hover : (conv.active ? Theme.hover : transparent);
    border-radius: 10px;

    ta := TouchArea {
        clicked => { root.open-it(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.conv.title;
                font-size: 14px;
                color: Theme.text;
                font-family: Theme.font-body;
                overflow: elide;
                wrap: no-wrap;
            }
            Text {
                text: root.conv.stamp;
                font-size: 11px;
                color: Theme.text-3;
                font-family: Theme.font-body;
            }
        }

        del := TouchArea {
            width: 34px;
            // sətirin DAXİLİ hündürlüyü (54 − 6−6 padding) — 54px olsaydı
            // qonşu sətirlərin üstünə daşıb yanlış toxunmalara səbəb olurdu
            height: 42px;
            clicked => { root.delete-it(); }
            IconTrash {
                x: 9px; y: 13px; width: 16px; height: 16px;
                stroke: del.has-hover ? #e03131 : Theme.text-3; stroke-width: 1.8px;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    // arxa fon
    background: #80000000;


    TouchArea {
        clicked => { App.sidebar-open = false; }
    }

    // panel
    Rectangle {
        x: 0; y: 0;
        width: Math.min(parent.width * 0.86, 320px);
        height: parent.height;
        background: Theme.nav-bg;

        HorizontalLayout {
            padding: 12px;
            spacing: 8px;

            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;

                // başlıq sırası
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: "Z.ai";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text;
                        font-family: Theme.font-serif;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    TouchArea {
                        width: 34px; height: 34px;
                        clicked => { App.sidebar-open = false; }
                        IconX { x: 8px; y: 8px; width: 18px; height: 18px; stroke: Theme.text-2; stroke-width: 2px; }
                    }
                }

                // yeni söhbət
                Rectangle {
                    height: 42px;
                    border-radius: 10px;
                    background: newc.has-hover ? Theme.hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    newc := TouchArea {
                        clicked => { App.new-chat(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        alignment: start;
                        IconPlus {
                            width: 18px; height: 18px; y: 12px;
                            stroke: Theme.text; stroke-width: 2px;
                        }
                        Text {
                            text: "New Chat";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text;
                            font-family: Theme.font-body;
                            vertical-alignment: center;
                        }
                    }
                }

                // siyahı
                if App.history-loading : Text {
                    text: "Loading…";
                    color: Theme.text-3;
                    font-size: 13px;
                    font-family: Theme.font-body;
                }
                if !App.history-loading && App.conversations.length == 0 : Text {
                    text: App.is-guest ? "Sign in to sync your chat history" : "No conversations yet";
                    color: Theme.text-3;
                    font-size: 13px;
                    font-family: Theme.font-body;
                    wrap: word-wrap;
                }

                if App.conversations.length > 0 : conv-list := ListView {
                    for c in App.conversations : ConvRow {
                        width: parent.width;
                        conv: c;
                        open-it() => { App.open-conversation(c.id); }
                        delete-it() => { App.delete-conversation(c.id); }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // hesab sırası
                Rectangle {
                    height: 52px;
                    border-radius: 10px;
                    background: acct.has-hover ? Theme.hover : transparent;
                    acct := TouchArea {
                        clicked => {
                            if (App.is-guest) {
                                App.sidebar-open = false;
                                App.login-step = 0;
                                App.authed = false;
                            } else {
                                App.sign-out();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 30px; height: 30px; y: 11px;
                            border-radius: 15px;
                            background: Theme.subtle;
                            Text {
                                text: App.is-guest ? "?" : "";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text;
                                font-family: Theme.font-body;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: App.is-guest ? "Sign in to Z.ai" : App.user-name;
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text;
                            font-family: Theme.font-body;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if !App.is-guest : Text {
                            text: "Sign out";
                            font-size: 12px;
                            color: Theme.text-3;
                            font-family: Theme.font-body;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
