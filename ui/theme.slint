// chat.z.ai veb dizayn sisteminin dəqiq tokenləri (light tema).
// Mənbə: veb CSS dəyişənləri + brauzerdə ölçülmüş computed styles.

// Şriftlər compile-time binariyə gömülür (Android-də sistem şrift problemi sıfırlanır)
import "../assets/fonts/Carlito-Regular.ttf";
import "../assets/fonts/Carlito-Bold.ttf";
import "../assets/fonts/CrimsonText-Bold.ttf";
import "../assets/fonts/DejaVuSansMono.ttf";

export global Theme {
    // ---- Rənglər (veb CSS dəyişənlərindən) ----
    // --color-bg-page: #f8f8f8, html/body: #f0f0f0
    out property <color> page        : #f0f0f0;   // ana fon
    out property <color> nav-bg      : #f8f8f8;   // yuxarı naviqasiya
    out property <color> surface     : #ffffff;   // kapsul, popup, modal
    out property <color> bubble-user : #eaeaea;   // istifadəçi balonu (r12)
    out property <color> hover       : #f0f0f0;
    out property <color> subtle      : #d9d9d9;
    out property <color> disabled-bg : #e6e6e6;

    // ---- Mətn ----
    out property <color> text        : #0d0d0d;   // --color-text-primary
    out property <color> text-2      : #5c5c5c;   // --color-text-secondary
    out property <color> text-3      : #888888;   // --color-text-tertiary
    out property <color> placeholder : #adadad;   // --color-text-placeholder
    out property <color> inverted    : #ffffff;

    // ---- Sərhədlər ----
    out property <color> border      : #1a0d0d0d; // rgba(13,13,13,0.1)
    out property <color> border-strong: #260d0d0d;

    // ---- Qara əsas düymə (#0d0d0d, radius 6) ----
    out property <color> btn-dark    : #0d0d0d;
    out property <color> btn-dark-hov: #2d2d2d;

    // ---- Vərginlər ----
    out property <length> nav-h        : 48px;
    out property <length> screen-pad   : 24px;
    out property <length> capsule-r    : 24px;
    out property <length> btn-r        : 6px;
    out property <length> bubble-r     : 12px;
    out property <length> composer-max-h: 160px;

    // ---- Şrift ailələri ----
    out property <string> font-body   : "Carlito";
    out property <string> font-serif  : "Crimson Text";
    out property <string> font-mono   : "DejaVu Sans Mono";
}
