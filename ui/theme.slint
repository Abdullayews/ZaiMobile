// chat.z.ai veb dizayn sisteminin dəqiq tokenləri — DARK (standart) + LIGHT.
// Mənbə: saytın CSS dəyişənləri (index-BNbpqIJS.css .dark və :root blokları).

// Şriftlər compile-time binariyə gömülür (Android-də sistem şrift problemi sıfırlanır)
import "../assets/fonts/Carlito-Regular.ttf";
import "../assets/fonts/Carlito-Bold.ttf";
import "../assets/fonts/CrimsonText-Bold.ttf";
import "../assets/fonts/DejaVuSansMono.ttf";

export global Theme {
    // ---- Mövzu ----
    in-out property <bool> dark: true;   // saytın dark modu (istifadəçinin seçimi)

    // ---- Rənglər: səthlər ----
    // dark:  --color-bg-bg:#2b2b2b  --color-bg-page:#161616  --color-bg-surface:#202020
    // light: --color-bg-bg:#fff     --color-bg-page:#f8f8f8  --color-bg-surface:#f0f0f0
    out property <color> page        : dark ? #161616 : #f0f0f0;
    out property <color> bg          : dark ? #2b2b2b : #ffffff;
    out property <color> nav-bg      : dark ? #161616 : #f8f8f8;
    out property <color> surface     : dark ? #202020 : #ffffff;
    out property <color> surface-2   : dark ? #2b2b2b : #f0f0f0;
    out property <color> overlay     : dark ? #2b2b2b : #e6e6e6;
    out property <color> bubble-user : dark ? #2b2b2b : #eaeaea;
    out property <color> hover       : dark ? #ffffff0d : #0d0d0d0d;
    out property <color> subtle      : dark ? #363636 : #d9d9d9;
    out property <color> disabled-bg : dark ? #363636 : #e6e6e6;
    out property <color> code-bg     : dark ? #181818 : #181818;

    // ---- Mətn ----
    out property <color> text        : dark ? #f8f8f8 : #0d0d0d;
    out property <color> text-2      : dark ? #adadad : #5c5c5c;
    out property <color> text-3      : dark ? #747474 : #888888;
    out property <color> placeholder : dark ? #474747 : #adadad;
    out property <color> inverted    : dark ? #0d0d0d : #ffffff;
    out property <color> accent      : dark ? #4099ff : #1a7fff;
    out property <color> success     : dark ? #88dda8 : #1e8a3e;
    out property <color> danger      : dark ? #ffb3b3 : #d4380d;
    out property <color> danger-bg   : dark ? #420000 : #fff0f0;

    // ---- Sərhədlər ----
    out property <color> border      : dark ? #ffffff1a : #0d0d0d1a;
    out property <color> border-strong: dark ? #ffffff26 : #0d0d0d26;

    // ---- Əsas düymə (dark: ağ, light: qara) ----
    out property <color> btn-dark    : dark ? #ffffff : #0d0d0d;
    out property <color> btn-dark-hov: dark ? #e8e8e8 : #2d2d2d;
    out property <color> btn-text    : dark ? #0d0d0d : #ffffff;

    // ---- Vərginlər ----
    out property <length> nav-h        : 48px;
    out property <length> screen-pad   : 24px;
    out property <length> capsule-r    : 24px;
    out property <length> btn-r        : 6px;
    out property <length> bubble-r     : 12px;
    out property <length> composer-max-h: 160px;

    // ---- Şrift ailələri ----
    out property <string> font-body   : "Carlito";
    out property <string> font-serif  : "Crimson Text";
    out property <string> font-mono   : "DejaVu Sans Mono";
}
