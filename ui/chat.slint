// ============================================================
//  Chat ekranı: nav + mesajlar (welcome daxil) + composer
//  Saytın dizaynı ilə 1:1 (dark standart, light da dəstəklənir)
// ============================================================

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { MessageBlock, ChatMessage, Attachment } from "state.slint";
import { ListView } from "std-widgets.slint";
import {
    IconPlus, IconStop, IconCopy, IconCheck, IconRefresh, IconChevronDown,
    IconArrowDown, IconAlert, IconSquarePen, IconX, IconPanelLeft, SendArrow,
    IconImage, IconFileDoc, IconVideoFile,
} from "icons.slint";

// ---------- Kod bloku ----------

component CodeBlock inherits Rectangle {
    in property <string> code;
    in property <string> lang;
    callback copy-code(string);
    property <bool> copied: false;

    background: Theme.code-bg;
    border-radius: 8px;
    height: 30px + code-area.height;

    // başlıq sətri
    Rectangle {
        y: 0;
        height: 30px;
        background: #212121;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            alignment: start;

            Text {
                text: root.lang != "" ? root.lang : "code";
                color: #8a8a8a;
                font-size: 12px;
                font-family: Theme.font-body;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            cp := TouchArea {
                width: 36px; height: 30px;
                clicked => { root.copy-code(root.code); root.copied = true; }
                if !root.copied : IconCopy {
                    x: 10px; y: 7px; width: 16px; height: 16px;
                    stroke: cp.has-hover ? #ffffff : #8a8a8a; stroke-width: 1.6px;
                }
                if root.copied : IconCheck {
                    x: 10px; y: 7px; width: 16px; height: 16px;
                    stroke: #52c41a; stroke-width: 2px;
                }
            }
        }
    }

    // kod sahəsi (üfüqi sürüşmə)
    code-area := Flickable {
        y: 30px;
        width: parent.width;
        height: Math.min(320px, txt.preferred-height + 20px);
        content-width: Math.max(txt.preferred-width + 20px, self.width);

        txt := Text {
            x: 10px; y: 10px;
            text: root.code;
            color: #e8e8e8;
            font-size: 12.5px;
            font-family: Theme.font-mono;
            wrap: no-wrap;
        }
    }
}

// ---------- Mesajın bir bloku ----------

component BlockRow inherits VerticalLayout {
    in property <MessageBlock> block;
    callback copy-code(string);

    if block.kind == 0 : Text {
        text: block.text;
        color: Theme.text;
        font-size: 15px;
        font-family: Theme.font-body;
        wrap: word-wrap;
    }
    if block.kind == 1 : CodeBlock {
        code: block.text;
        lang: block.lang;
        copy-code(c) => { root.copy-code(c); }
    }
    if block.kind == 2 : Text {
        text: "•  " + block.text;
        color: Theme.text;
        font-size: 15px;
        font-family: Theme.font-body;
        wrap: word-wrap;
    }
    if block.kind == 3 : Text {
        text: block.text;
        color: Theme.text;
        font-size: 17px;
        font-weight: 700;
        font-family: Theme.font-body;
        wrap: word-wrap;
    }
    if block.kind == 4 : Rectangle {
        height: qtext.preferred-height + 4px;
        Rectangle {
            x: 0; y: 2px; width: 3px; height: parent.height - 4px;
            background: Theme.subtle;
            border-radius: 2px;
        }
        qtext := Text {
            x: 12px; width: parent.width - 12px;
            text: block.text;
            color: Theme.text-2;
            font-size: 15px;
            font-family: Theme.font-body;
            wrap: word-wrap;
        }
    }
}

// ---------- Mesajın əlavə önizləməsi ----------

component AttachmentChip inherits Rectangle {
    in property <Attachment> att;
    height: 30px;
    width: row.preferred-width + 8px;
    background: Theme.surface-2;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    row := HorizontalLayout {
        padding-left: 6px; padding-right: 8px;
        padding-top: 4px; padding-bottom: 4px;
        spacing: 6px;
        alignment: start;

        if att.media == "image" : IconImage {
            width: 16px; height: 16px; stroke: Theme.text-2; stroke-width: 1.6px;
        }
        if att.media == "video" : IconVideoFile {
            width: 16px; height: 16px; stroke: Theme.text-2; stroke-width: 1.6px;
        }
        if att.media == "doc" : IconFileDoc {
            width: 16px; height: 16px; stroke: Theme.text-2; stroke-width: 1.6px;
        }
        Text {
            text: att.name;
            color: att.status == 2 ? Theme.danger : Theme.text;
            font-size: 12px;
            font-family: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            width: 150px;
        }
        if att.status == 0 : Text {
            text: "…";
            color: Theme.text-3;
            font-size: 12px;
            vertical-alignment: center;
        }
        if att.status == 1 : IconCheck {
            width: 13px; height: 13px; stroke: Theme.success; stroke-width: 2.2px;
        }
    }
}

// ---------- Bir mesaj (ListView elementi) ----------

component MessageRow inherits VerticalLayout {
    in property <ChatMessage> msg;
    in property <int> index;
    property <bool> copied: false;
    callback copy-text(string);
    callback copy-code(string);
    callback regenerate();

    // Sətir ListView tərəfindən YARADILANDA (yalnız görünəndə) markdown
    // bloklarının parse-ını Rust-dan xahiş et — bütün tarixçə yox, tək sətir.
    init => { App.ensure-blocks-parsed(root.index); }

    spacing: 4px;
    padding-top: 10px;
    padding-bottom: 10px;

    // ---- istifadəçi: sağda boz balon ----
    if msg.role == "user" : VerticalLayout {
        alignment: end;
        spacing: 6px;

        // əlavələr (balon üstündə)
        if msg.files.length > 0 : HorizontalLayout {
            alignment: end;
            spacing: 6px;
            for a in msg.files : AttachmentChip { att: a; }
        }

        bubble := Rectangle {
            width: min(parent.width * 0.85, btext.preferred-width + 26px);
            height: btext.preferred-height + 20px;
            background: Theme.bubble-user;
            border-radius: Theme.bubble-r;
            btext := Text {
                x: 13px; y: 10px;
                width: parent.width - 26px;
                text: root.msg.text;
                color: Theme.text;
                font-size: 15px;
                font-family: Theme.font-body;
                wrap: word-wrap;
            }
        }
    }

    // ---- assistant: solda, tam en ----
    if msg.role == "assistant" : VerticalLayout {
        spacing: 4px;

        // xəta (+retry göstəricisi) — bütün sətir toxunulandır: "tap to
        // retry" mətni REAL retry işə salır (əvvəl TouchArea yox idi — yazı
        // "toxun" deyirdi, amma toxunma işləmirdi)
        if msg.error : TouchArea {
            clicked => { App.retry-send(); }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                IconAlert {
                    width: 17px; height: 17px; stroke: Theme.danger; stroke-width: 2px;
                }
                Text {
                    text: root.msg.retrying ? root.msg.text + "\n\nRetrying automatically…" : root.msg.text;
                    color: Theme.danger;
                    font-size: 14px;
                    font-family: Theme.font-body;
                    wrap: word-wrap;
                }
            }
        }

        // markdown blokları
        if !msg.error : VerticalLayout {
            spacing: 8px;
            for blk in msg.blocks : BlockRow {
                block: blk;
                copy-code(c) => { root.copy-code(c); }
            }
            // gözləmə nöqtələri
            if msg.streaming && msg.blocks.length == 0 : HorizontalLayout {
                spacing: 12px;
                padding-top: 4px;
                padding-bottom: 2px;
                for i in 3 : Rectangle {
                    width: 7px; height: 7px; border-radius: 4px;
                    background: Theme.text-3;
                    opacity: i == Math.mod(App.dot-tick, 3) ? 1.0 : 0.35;
                }
                Text {
                    text: App.phase != "" ? App.phase : "Thinking";
                    color: Theme.text-2;
                    font-size: 13px;
                    font-family: Theme.font-body;
                    vertical-alignment: center;
                }
            }
        }

        // əməliyyat sırası (yalnız bitmiş mesajlarda)
        if !msg.streaming && !msg.error && msg.text != "" : HorizontalLayout {
            spacing: 0px;
            padding-top: 4px;
            alignment: start;

            act := TouchArea {
                width: 32px; height: 30px;
                clicked => { root.copy-text(root.msg.text); root.copied = true; }
                if root.copied : IconCheck {
                    x: 8px; y: 7px; width: 16px; height: 16px; stroke: Theme.success; stroke-width: 2px;
                }
                if !root.copied : IconCopy {
                    x: 8px; y: 7px; width: 16px; height: 16px;
                    stroke: act.has-hover ? Theme.text : Theme.text-3; stroke-width: 1.6px;
                }
            }
            if root.index == App.messages.length - 1 && !App.streaming && App.messages.length > 1 : regen := TouchArea {
                width: 32px; height: 30px;
                clicked => { root.regenerate(); }
                IconRefresh {
                    x: 8px; y: 7px; width: 16px; height: 16px;
                    stroke: regen.has-hover ? Theme.text : Theme.text-3; stroke-width: 1.6px;
                }
            }
        }
    }
}

// ---------- Welcome (boş söhbət) ----------

component SuggestionCard inherits Rectangle {
    in property <image> img;
    in property <string> label;
    callback picked(string);

    // Web-exact card: total 164 = 140 (box) + 6 (gap) + 18 (label).
    // The button itself is transparent on the web; only the inner box shows.
    height: 164px;
    background: transparent;

    ta := TouchArea {
        clicked => { root.picked(root.label); }
    }

    // Visual box: web .rounded-2xl (16px) + bg-overlay, no border, overflow-hidden
    Rectangle {
        y: 0;
        height: 140px;
        width: 100%;
        background: ta.has-hover ? Theme.hover : Theme.overlay;
        border-radius: 16px;
        clip: true;

        // Image region: web inset-x-13px / top-25px / -bottom-1px => 116px tall.
        // image-fit:contain reproduces the web object-contain behavior for every
        // card (all source arts are wide), so no per-image height tuning is needed.
        Image {
            x: 13px;
            y: 25px;
            width: parent.width - 26px;
            height: 116px;
            source: root.img;
            image-fit: contain;
        }
    }

    // Label: web 13px/500 text-2, 6px below the box, centered
    Text {
        y: 146px;
        height: 18px;
        width: 100%;
        text: root.label;
        font-size: 13px;
        font-weight: 500;
        color: Theme.text-2;
        font-family: Theme.font-body;
        horizontal-alignment: center;
    }
}

component WelcomeContent inherits Rectangle {
    callback pick-suggestion(string);

    // Web behavior: the empty-state content is anchored to the TOP of the
    // message area (fixed paddings), the composer is bottom-anchored, and the
    // gap between them grows with the screen height. Scrollable when tight.
    Flickable {
        x: 0; y: 0;
        width: 100%;
        height: 100%;
        content-width: parent.width;
        content-height: wel.preferred-height;

        wel := VerticalLayout {
            width: parent.width;
            // On a phone: status(24) + nav(48) + 24 => heading at ~96px from
            // the window top, exactly like the web (h1 at 96px in a 412/559 viewport)
            padding-top: 24px;
            padding-left: Theme.screen-pad;
            padding-right: Theme.screen-pad;
            spacing: 24px;   // web: gap-6 between the h1 row and the grid

            // Web: 24px/700 serif, LEFT-aligned (not centered)
            Text {
                width: 100%;
                text: "More than coding...";
                font-family: Theme.font-serif;
                font-size: 24px;
                font-weight: 700;
                color: Theme.text;
            }

            // 2-column responsive grid (web: 2+2+1, last cell left empty)
            GridLayout {
                spacing: 16px;
                Row {
                    SuggestionCard { img: @image-url("../assets/cards/fullstack.png"); label: "Full-Stack"; picked(t) => { root.pick-suggestion(t); } }
                    SuggestionCard { img: @image-url("../assets/cards/writing.png"); label: "Writing"; picked(t) => { root.pick-suggestion(t); } }
                }
                Row {
                    SuggestionCard { img: @image-url("../assets/cards/data.png"); label: "Data Insight"; picked(t) => { root.pick-suggestion(t); } }
                    SuggestionCard { img: @image-url("../assets/cards/slides.png"); label: "PPT"; picked(t) => { root.pick-suggestion(t); } }
                }
                Row {
                    SuggestionCard { img: @image-url("../assets/cards/web.png"); label: "Web Site"; picked(t) => { root.pick-suggestion(t); } }
                    Rectangle { }
                }
            }
        }
    }
}

// ---------- Composer (giriş kapsulu) ----------

component Composer inherits Rectangle {
    callback send-msg(string);
    callback open-models();

    // Web-exact surface: --color-bg-bg (dark #2b2b2b / light #fff),
    // 1px hairline border, r24 capsule. Height: 132px empty
    // (12 + 52 + 24 + 30 + 12 + 2 border), like the web.
    background: Theme.bg;
    border-radius: Theme.capsule-r;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #28000000;

    property <bool> can-send: (App.input-text != "" || App.attachments.length > 0) && !App.streaming;

    VerticalLayout {
        // web: py-3 (12px) + px-3.5 (14px)
        padding: 12px;
        padding-left: 14px;
        padding-right: 14px;
        // web: 24px between the text area and the control row
        spacing: 24px;

        // attachment chips (row above the text area)
        if App.attachments.length > 0 : HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for a[i] in App.attachments : Rectangle {
                width: chip.width + 30px;
                height: 32px;
                chip := AttachmentChip { att: a; y: 1px; }
                rm := TouchArea {
                    x: parent.width - 28px; width: 28px; height: 32px;
                    clicked => { App.remove-attachment(i); }
                    IconX {
                        x: 8px; y: 8px; width: 14px; height: 14px;
                        stroke: rm.has-hover ? Theme.danger : Theme.text-3; stroke-width: 2px;
                    }
                }
            }
        }

        // Text area: web min-h-52px, 16px font. Long text is scrolled to the
        // cursor via Flickable (Slint TextEditBase cursor logic).
        Rectangle {
            height: Math.min(Math.max(input.preferred-height, 52px), Theme.composer-max-h);
            clip: true;
            input-flick := Flickable {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                content-width: parent.width;
                content-height: input.preferred-height;

                input := TextInput {
                    x: 0; y: 0;
                    width: parent.width;
                    height: self.preferred-height;
                    text <=> App.input-text;
                    font-size: 16px;
                    font-family: Theme.font-body;
                    color: Theme.text;
                    wrap: word-wrap;

                    cursor-position-changed(cpos) => {
                        if (cpos.y + input-flick.content-y < 0px) {
                            input-flick.content-y = max(input-flick.height - self.height, -cpos.y);
                        } else if (cpos.y + input-flick.content-y > input-flick.height - 20px) {
                            input-flick.content-y = min(0px, max(input-flick.height - self.height,
                                                 input-flick.height - cpos.y - 20px));
                        }
                    }
                }
            }
            if App.input-text == "" : Text {
                x: 0; y: 0;
                text: "Send a Message";
                color: Theme.placeholder;
                font-size: 16px;
                font-family: Theme.font-body;
            }
        }

        // Control row: web 30px tall, left "More" (plus) icon 30x30,
        // model chip as plain 16px text + chevron, send circle 30px.
        HorizontalLayout {
            spacing: 8px;

            // "More" button (web: plus icon, color text-3)
            clip := TouchArea {
                width: 30px; height: 30px;
                clicked => { App.open-picker(); }
                IconPlus {
                    x: 5px; y: 5px; width: 20px; height: 20px;
                    stroke: clip.has-hover ? Theme.text : Theme.text-3;
                    stroke-width: 2px;
                }
            }
            Rectangle { horizontal-stretch: 1; }

            // model selector (web: plain text + chevron, no pill)
            mbtn := TouchArea {
                width: mrow.preferred-width + 20px;
                height: 30px;
                clicked => { root.open-models(); }
                mrow := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: App.model-name;
                        font-size: 16px;
                        font-weight: 400;
                        color: Theme.text;
                        font-family: Theme.font-body;
                        vertical-alignment: center;
                    }
                    IconChevronDown {
                        width: 16px; height: 16px;
                        stroke: Theme.text-2; stroke-width: 2px;
                    }
                }
            }

            // send / stop (web: 30x30 circle; disabled bg --color-bg-disabled,
            // disabled icon text-2)
            Rectangle {
                width: 30px; height: 30px;
                border-radius: 15px;
                background: (root.can-send || App.streaming) ? Theme.btn-dark : Theme.disabled-bg;

                sbtn := TouchArea {
                    clicked => {
                        if (App.streaming) {
                            App.stop-generation();
                        } else if (root.can-send) {
                            root.send-msg(App.input-text);
                        }
                    }
                    if App.streaming : IconStop {
                        x: 7px; y: 7px; width: 16px; height: 16px;
                        fill: Theme.btn-text; stroke: Theme.btn-text; stroke-width: 1px;
                    }
                    if !App.streaming : SendArrow {
                        x: 6px; y: 6px; width: 18px; height: 18px;
                        stroke: root.can-send ? Theme.btn-text : Theme.text-2;
                        stroke-width: 2.4px;
                    }
                }
            }
        }
    }
}

// ============================================================
//  Əsas chat ekranı
// ============================================================

export component ChatScreen inherits Rectangle {
    // Edge-to-edge insets (set from the window safe-area; 0 on desktop)
    in property <length> status-inset: 0px;
    in property <length> nav-inset: 0px;

    background: Theme.page;

    forward-focus: input-scope;
    input-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (App.picker-open) { App.picker-open = false; return accept; }
                if (App.model-popup-open) { App.model-popup-open = false; return accept; }
                if (App.sidebar-open) { App.sidebar-open = false; return accept; }
            }
            reject
        }
    }

    VerticalLayout {
        // ---------- NAV (bg extends under the status bar; content below it) ----------
        Rectangle {
            height: Theme.nav-h + root.status-inset;
            background: Theme.nav-bg;

            Rectangle {
                y: root.status-inset;
                height: Theme.nav-h;
                width: 100%;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 12px;
                    spacing: 2px;

                    TouchArea {
                        width: 40px; height: 40px; y: 4px;
                        clicked => { App.sidebar-open = true; }
                        IconPanelLeft {
                            x: 10px; y: 10px; width: 20px; height: 20px;
                            stroke: Theme.text-2; stroke-width: 2px;
                        }
                    }
                    TouchArea {
                        width: 40px; height: 40px; y: 4px;
                        clicked => { App.new-chat(); }
                        IconSquarePen {
                            x: 10px; y: 10px; width: 20px; height: 20px;
                            stroke: Theme.text-2; stroke-width: 2px;
                        }
                    }

                    Rectangle { width: 6px; }

                    Text {
                        text: App.chat-title;
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.text;
                        font-family: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Rectangle { width: 6px; }

                    acct := TouchArea {
                        // web: 32px tall, r6, 14px text
                        width: Math.min(120px, acct-box.preferred-width + 24px);
                        height: 32px; y: 8px;
                        clicked => {
                            if (App.is-guest) {
                                App.login-error = "";
                                App.token-auto-detected = false;
                                App.login-step = 0;
                                App.authed = false;
                            } else {
                                App.sidebar-open = true;
                            }
                        }
                        Rectangle {
                            height: 32px;
                            width: parent.width;
                            border-radius: Theme.btn-r;
                            background: App.is-guest ? Theme.btn-dark : Theme.subtle;
                            acct-box := HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                alignment: center;
                                Text {
                                    text: App.is-guest ? "Sign in" : App.user-name;
                                    font-size: 14px;
                                    color: App.is-guest ? Theme.btn-text : Theme.text;
                                    font-family: Theme.font-body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------- XƏTA LENTİ ----------
        if App.banner != "" : Rectangle {
            height: 42px;
            background: Theme.danger-bg;
            HorizontalLayout {
                padding-left: 14px; padding-right: 6px;
                alignment: start;
                spacing: 8px;
                IconAlert { width: 16px; height: 16px; stroke: Theme.danger; stroke-width: 2px; y: 13px; }
                Text {
                    text: App.banner;
                    color: Theme.danger;
                    font-size: 13px;
                    font-family: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                TouchArea {
                    width: 36px; height: 42px;
                    clicked => { App.banner = ""; }
                    IconX { x: 10px; y: 13px; width: 16px; height: 16px; stroke: Theme.danger; stroke-width: 2px; }
                }
            }
        }

        // ---------- MESAJLAR ----------
        Rectangle {
            vertical-stretch: 1;
            // welcome
            if App.messages.length == 0 : WelcomeContent {
                width: 100%;
                height: 100%;
                pick-suggestion(t) => {
                    App.input-text = "Help me with " + t;
                }
            }

            // mesaj siyahısı + aşağı sürüşdür düyməsi
            if App.messages.length > 0 : Rectangle {
                width: 100%;
                height: 100%;
                msgs := ListView {
                    x: 0; width: parent.width; height: parent.height;

                    for m[i] in App.messages : MessageRow {
                        width: parent.width;
                        msg: m;
                        index: i;
                        copy-text(t) => { App.copy-to-clipboard(t); App.show-toast("Copied"); }
                        copy-code(c) => { App.copy-to-clipboard(c); App.show-toast("Code copied"); }
                        regenerate() => { App.regenerate(); }
                    }

                    changed content-height => {
                        if (App.auto-scroll) {
                            self.content-y = self.visible-height - self.content-height;
                        }
                    }
                    changed content-y => {
                        App.auto-scroll = self.content-y >= self.visible-height - self.content-height - 60px;
                    }
                }

                // aşağı sürüşdür düyməsi
                if !App.auto-scroll : Rectangle {
                    x: parent.width - 62px;
                    y: parent.height - 58px;
                    width: 42px; height: 42px;
                    border-radius: 21px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #33000000;

                    fab := TouchArea {
                        clicked => {
                            App.auto-scroll = true;
                            msgs.content-y = msgs.visible-height - msgs.content-height;
                        }
                        IconArrowDown {
                            x: 11px; y: 11px; width: 20px; height: 20px;
                            stroke: Theme.text-2; stroke-width: 2px;
                        }
                    }
                }
            }
        }

        // ---------- COMPOSER + FOOTER (bottom-anchored, web-exact) ----------
        Rectangle {
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: Theme.screen-pad;
                padding-right: Theme.screen-pad;
                padding-top: 6px;
                // web: footer mb-2px; keep clear of the gesture/nav bar
                padding-bottom: 2px + root.nav-inset;
                // web: 24px between the composer and the footer lines
                spacing: 24px;
                alignment: start;

                Composer {
                    send-msg(t) => { App.send(t); }
                    open-models() => { App.model-popup-open = true; }
                }

                // web footer: two centered lines, gap-2 (8px)
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        height: 16px;
                        width: 100%;
                        text: "Generated by AI. For reference only.";
                        font-size: 10px;
                        color: Theme.text;
                        font-family: Theme.font-body;
                        horizontal-alignment: center;
                    }
                    Text {
                        height: 16px;
                        width: 100%;
                        text: "Terms of Service and Privacy Policy";
                        font-size: 10px;
                        color: Theme.text;
                        font-family: Theme.font-body;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
