// ============================================================
//  Z.ai — chat.z.ai veb UI-nun native (Slint) replikası
//  Kök pəncərə: ekranların və overlay-lərin toplanması
// ============================================================

import { Theme } from "theme.slint";
import { App } from "state.slint";
export { App, ChatMessage, MessageBlock, ConvItem, ModelItem, Attachment, PickedFile } from "state.slint";
import { ChatScreen } from "chat.slint";
import { LoginScreen } from "login.slint";
import { Spinner } from "std-widgets.slint";
import { Sidebar } from "sidebar.slint";
import { ModelPopup, PhaseToast, FilePickerModal } from "modals.slint";


export component AppWindow inherits Window {
    // Preferred (initial) size only. A FIXED width/height would pin the window
    // to 412x915 on Android instead of letting it fill the real screen
    // (the user's device is 559x1241 logical — a fixed 412x915 left ~26% of
    // the display black). Android uses the native window size; desktop opens
    // at this size.
    preferred-width: 412px;
    preferred-height: 915px;
    background: Theme.page;

    // ---- Açılış splash (booting) ----
    if App.booting : Rectangle {
        background: Theme.page;
        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 40px;
            source: @image-url("../assets/logo.png");
            width: 72px; height: 72px;
        }
        Spinner {
            x: (parent.width - self.width) / 2;
            y: parent.height / 2 + 40px;
            indeterminate: true;
        }
    }

    // ---- Login (authed olmayana qədər) ----
    if !App.authed && !App.booting : LoginScreen {
        status-inset: root.safe-area-insets.top;
        nav-inset: root.safe-area-insets.bottom;
    }

    // ---- Əsas chat ----
    if App.authed && !App.booting : ChatScreen {
        status-inset: root.safe-area-insets.top;
        nav-inset: root.safe-area-insets.bottom;
    }

    // ---- Overlaylər ----
    if App.sidebar-open : Sidebar { status-inset: root.safe-area-insets.top; }
    if App.model-popup-open : ModelPopup { }
    if App.picker-open : FilePickerModal { }
    PhaseToast { }
}
