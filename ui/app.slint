// ============================================================
//  Z.ai — chat.z.ai veb UI-nun native (Slint) replikası
//  Kök pəncərə: ekranların və overlay-lərin toplanması
// ============================================================

import { Theme } from "theme.slint";
import { App } from "state.slint";
export { App, ChatMessage, MessageBlock, ConvItem, ModelItem } from "state.slint";
import { ChatScreen } from "chat.slint";
import { Sidebar } from "sidebar.slint";
import { SignInModal, ModelPopup, PhaseToast } from "modals.slint";

export component AppWindow inherits Window {
    // Desktop preview ölçüsü (Android-də tam ekran bu dəyəri əvəz edir)
    width: 412px;
    height: 915px;
    background: Theme.page;
    // Android: klaviatura pəncərəni yenidən ölçür (adjustResize manifestdə)
    ChatScreen { }

    if App.sidebar-open : Sidebar { }
    if App.model-popup-open : ModelPopup { }
    if App.signin-open : SignInModal { }
    PhaseToast { }
}
