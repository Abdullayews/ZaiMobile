<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Əsas (chat) ekranı — öz başlığı var, ActionBar yoxdur -->
    <style name="Theme.Zai" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <!-- Tarixçə / Parametrlər — standart ActionBar -->
    <style name="Theme.Zai.Bar" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Təklif çipləri -->
    <style name="ChipStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip_outline</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
